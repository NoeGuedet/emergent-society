{
  "name": "emergent-society",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "build:native": "node scripts/build-native.mjs",
    "test:first-light": "npm run build && node scripts/first-light-smoke.mjs",
    "test:first-light-packages": "npm run build && node scripts/first-light-packages-smoke.mjs",
    "live:first-light": "node scripts/first-light-live.mjs",
    "start": "node dist/host/main.js"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.15",
    "canonicalize": "5.0.0"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
